#!/usr/bin/env bash
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${HOOK_DIR}/.." && pwd)"

log() {
  printf '[pre-push] %s\n' "$1"
}

log "Building firmware..."
if ! env PLATFORMIO_CORE_DIR=/tmp/pio-core pio run -d "${PROJECT_DIR}"; then
  log "Build failed. Push aborted."
  exit 1
fi

log "Build finished successfully. Auto-deploy is disabled."
